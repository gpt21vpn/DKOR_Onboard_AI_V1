# ========= DKOR Onboard V1 =========
ENVIRONMENT=development
DEFAULT_PROVIDER=auto
AUTO_PROVIDER_ORDER=gigachat,groq,qwen,openai,local
TOP_K=5
MEMORY_TURNS=6
ADMIN_TOKEN=

# Optional outbound HTTP/HTTPS proxy for external AI/TTS APIs.
# Example: http://127.0.0.1:10809
OUTBOUND_PROXY_URL=

# --- GigaChat ---
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CHAT_MODEL=GigaChat-2-Max
# If Windows/server lacks the required Russian root CA, temporarily set false only for debugging.
GIGACHAT_VERIFY_SSL=true

# --- Groq: chat + Russian STT Whisper ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Qwen / DashScope OpenAI-compatible ---
QWEN_API_KEY=
QWEN_CHAT_MODEL=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- OpenAI (optional) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Natural Russian TTS: Yandex SpeechKit ---
# Preferred: service-account API key. Leave folder id empty with API key auth.
YANDEX_SPEECHKIT_API_KEY=
# Alternative: IAM token + folder id.
YANDEX_SPEECHKIT_IAM_TOKEN=
YANDEX_SPEECHKIT_FOLDER_ID=
TTS_VOICE_PRIMARY=marina
TTS_VOICE_PRIMARY_ROLE=neutral
TTS_VOICE_SECONDARY=ermil
TTS_VOICE_SECONDARY_ROLE=neutral

# Optional Groq Orpheus TTS for ENGLISH only (Russian is not supported there as of Oct 2026).
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

RATE_LIMIT_ENABLED=true

TRUST_PROXY_HEADERS=false
